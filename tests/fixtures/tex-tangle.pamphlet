% -*- mode: literate-latex -*-
% Tangle fixture for what a TeX-side tangle could get wrong, compared with
% the CL tangle: `#' (macro parameter), `%' (comment), `{' `}', `\', UTF-8,
% blank lines, leading spaces, a tab, an [opts] argument, compounding
% indents, a tab-indented reference, a begin line with whitespace before
% its brace, a chunk name with a space, and text after the name's brace.
\begin{chunk}{*}
\documentclass{standalone}
\tikzset{px/.style={line width={#1/4151*\R}}}   % 红底 #D14924
  \getchunk{body}
	\getchunk{tab ref}

\end{chunk}

\begin{chunk}[load=no]{body}
\begin{tikzpicture}
	\fill (0,0) circle (1);  % a tab-indented line
  \getchunk{inner}
\end{tikzpicture}
\end{chunk}

\begin{chunk}{inner}
\node {太极};
\end{chunk}

 	\begin{chunk} {tab ref}   % indented begin line, space before the brace
tab-ref-body
\end{chunk}
